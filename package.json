{
  "name": "kbayro/master-components",
  "version": "0.2.0",
  "description": "Reusable React components for CRUD and search/select workflows for master data.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "demo": "vite --config vite.config.ts",
    "build:demo": "vite build --config vite.config.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "typescript",
    "master-data",
    "crud",
    "selector",
    "autocomplete"
  ],
  "license": "MIT"
}
